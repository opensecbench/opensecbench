{
  "id": "opensecbench.trufflehog",
  "name": "TruffleHog secrets scanner",
  "version": "1.0.0",
  "publisher": "opensecbench",
  "capabilities": [
    {
      "id": "trufflehog",
      "version": "1.0.0",
      "title": "TruffleHog (secrets)",
      "description": "Scans a source tree for verified secrets. Offline (no network).",
      "image": "trufflesecurity/trufflehog:3.82.6",
      "cmd": ["filesystem", "/src", "--json", "--no-update"],
      "network": "none",
      "mount_source": true,
      "mount_target": "/src",
      "output_name": "trufflehog.json",
      "output_media_type": "application/x-trufflehog-json",
      "ok_exit_codes": [0, 183],
      "timeout_seconds": 600,
      "memory_mb": 2048,
      "dispositions": [
        { "when": { "verified": "true" }, "action": "finding" },
        { "when": { "verified": "false" }, "action": "investigate" }
      ]
    }
  ],
  "settings": [
    {
      "id": "trufflehog",
      "title": "TruffleHog",
      "icon": "🔑",
      "order": 60,
      "fields": [
        {
          "key": "trufflehog.only_verified",
          "label": "Only report verified secrets",
          "type": "bool",
          "default": "true",
          "description": "Skip unverified matches to cut noise — verified secrets were live-checked against the provider."
        },
        {
          "key": "trufflehog.min_severity",
          "label": "Minimum severity to import",
          "type": "select",
          "default": "medium",
          "description": "Observations below this severity are discarded during interpretation.",
          "options": [
            { "value": "info", "label": "Info and above" },
            { "value": "medium", "label": "Medium and above" },
            { "value": "high", "label": "High only" }
          ]
        }
      ]
    }
  ]
}
